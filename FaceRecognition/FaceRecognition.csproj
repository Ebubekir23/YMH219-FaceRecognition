<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- OpenCV yerel kütüphanesi 64 bit -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV'nin hazır yüz algılama modeli programın yanına kopyalanır -->
    <None Update="Kaynaklar\haarcascade_frontalface_default.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
